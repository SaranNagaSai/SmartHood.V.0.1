# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/smarthood
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/smarthood
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret (Generate a random secure string)
# NOTE: The env var name MUST be SMARTHOOD_JWT_SECRET (not JWT_SECRET)
SMARTHOOD_JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Brevo SMTP Relay)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=2525
EMAIL_USER=your-brevo-smtp-user
EMAIL_PASSWORD=your-brevo-smtp-password
EMAIL_FROM=your-sender-email@gmail.com

# Twilio Configuration (SMS & OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_SENDER_ID=SmartHood
